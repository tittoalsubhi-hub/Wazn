<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand_teal">#1B6B2A</color>
    <color name="splash_bg">#F3F7F3</color>
    <style name="Theme.BudgetSMS" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="colorPrimary">@color/brand_teal</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.BudgetSMS.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_teal</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.BudgetSMS</item>
    </style>
</resources>
